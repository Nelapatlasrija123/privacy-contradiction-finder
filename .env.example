# Privacy Contradiction Finder - Environment Configuration Template
# Copy this file to .env and add your actual API keys if you want to use LLM features.
# If left empty, the application automatically uses the 100% offline rule-based analyzer.

# Optional: Gemini API Key or OpenAI API Key
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Mode: RULE_BASED (default) or HYBRID
ANALYSIS_MODE=RULE_BASED
